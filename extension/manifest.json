
{
  "manifest_version": 3,
  "name": "RabbitHole",
  "version": "0.3.1",
  "description": "Turn browsing sessions into interactive knowledge graphs.",
  "action": {
    "default_title": "RabbitHole",
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "background": {
    "scripts": ["background.js"]
  },
 

"browser_specific_settings": {
  "gecko": {
    "id": "rabbithole@local.dev",
    "data_collection_permissions": {
      "required": ["none"]
    }
  }  }
}
