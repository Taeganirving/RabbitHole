
{
  "manifest_version": 3,
  "name": "RabbitHole",
  "version": "0.3.1",
  "description": "Turn browsing sessions into interactive knowledge graphs.",
  "action": {
    "default_title": "RabbitHole",
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:5173/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:5173/*"
      ],
      "js": ["explorer-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "rabbithole@local.dev"
    }
  }
}
